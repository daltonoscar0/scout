.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Raw and derived data are never committed. Everything here is refetchable
# or rebuildable from `scout build`.
data/raw/
data/derived/
models/

# Transfermarkt data is fetched at build time behind an explicit opt-in flag
# and is deliberately never redistributed from this repo. See docs/licensing.md.
data/transfermarkt/

# The demo bundle IS committed, deliberately. The spec's acceptance criterion is
# "fresh clone + `scout demo` works offline", and everything else under data/ is
# ignored, so if the bundle were ignored too a fresh clone would have nothing to
# run and the criterion would be unsatisfiable. It is a few hundred KB.
*.xlsx
!tests/fixtures/*.xlsx
CLAUDE.md
AGENTS.md
.claude/
.agentnotes/
.cursor/
.mcp.json
tasks/lessons.md
tasks/todo.md
